<!--
  Suricata -> Wazuh: severity x confidence ladder (hand-written).
  Tuning rules are GENERATED from tuning/intents/ into 100220-suricata_tuning.xml - see tools/render.py.
  IDs: 100200-100299 (see wazuh/README.md registry). Lab addresses only (10.10.0.0/16).
  Parent 86601 is the stock Wazuh "Suricata: Alert" rule (event_type alert).
  Analyst-visible threshold in this kit: level >= 6 (WAZUH_ALERT_LEVEL).
-->
<group name="suricata,custom,">

  <!-- Critical -->
  <rule id="100200" level="10">
    <if_sid>86601</if_sid>
    <field name="alert.metadata.signature_severity">Critical</field>
    <description>Suricata Critical: $(alert.signature)</description>
    <group>suricata,critical,</group>
  </rule>

  <rule id="100201" level="11">
    <if_sid>100200</if_sid>
    <field name="alert.metadata.confidence">Medium</field>
    <description>Suricata Critical / Medium confidence: $(alert.signature)</description>
    <group>suricata,critical,medium_confidence,</group>
  </rule>

  <rule id="100202" level="13">
    <if_sid>100200</if_sid>
    <field name="alert.metadata.confidence">High</field>
    <description>Suricata Critical / High confidence: $(alert.signature)</description>
    <group>suricata,critical,high_confidence,</group>
  </rule>

  <!-- Major -->
  <rule id="100203" level="7">
    <if_sid>86601</if_sid>
    <field name="alert.metadata.signature_severity">Major</field>
    <description>Suricata Major: $(alert.signature)</description>
    <group>suricata,major,</group>
  </rule>

  <rule id="100204" level="8">
    <if_sid>100203</if_sid>
    <field name="alert.metadata.confidence">Medium</field>
    <description>Suricata Major / Medium confidence: $(alert.signature)</description>
    <group>suricata,major,medium_confidence,</group>
  </rule>

  <rule id="100205" level="9">
    <if_sid>100203</if_sid>
    <field name="alert.metadata.confidence">High</field>
    <description>Suricata Major / High confidence: $(alert.signature)</description>
    <group>suricata,major,high_confidence,</group>
  </rule>

  <!-- Minor: only High confidence reaches analysts -->
  <rule id="100206" level="6">
    <if_sid>86601</if_sid>
    <field name="alert.metadata.signature_severity">Minor</field>
    <field name="alert.metadata.confidence">High</field>
    <description>Suricata Minor / High confidence: $(alert.signature)</description>
    <group>suricata,minor,high_confidence,</group>
  </rule>

</group>
