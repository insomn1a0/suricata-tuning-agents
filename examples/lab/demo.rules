# Demo signatures for the fictional SIDs in examples/lab/make_sample_eve.py (9900000-9900099, never deployed).
# They give the triage agent rule text to read and `make render` metadata to check intents against.
alert dns $HOME_NET any -> any any (msg:"EXAMPLE DNS Query to Advertising/Tracking Domain"; dns.query; dotprefix; content:".adtrack.example"; endswith; nocase; classtype:misc-activity; sid:9900001; rev:1; metadata:signature_severity Minor, confidence High;)
alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"EXAMPLE TLS SNI of Remote Administration Tool Relay"; flow:established,to_server; tls.sni; dotprefix; content:".relay.remote-admin.example"; endswith; nocase; classtype:policy-violation; sid:9900002; rev:1; metadata:signature_severity Major, confidence Medium, mitre_technique_id T1219, mitre_technique_name Remote_Access_Software;)
alert http $HOME_NET any -> $HOME_NET any (msg:"EXAMPLE HTTP Basic Authorization over Cleartext"; flow:established,to_server; http.header; content:"Authorization|3a 20|Basic "; nocase; classtype:policy-violation; sid:9900003; rev:1; metadata:signature_severity Minor, confidence Medium, mitre_technique_id T1552, mitre_technique_name Unsecured_Credentials;)
