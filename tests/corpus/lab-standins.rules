# Corpus-only lab stand-ins. NOT production detections. ET rules are not vendored: 2025701 mimics the ET INFO
# signature the tuning intents refer to (same SID and metadata); 9190000-9199999 are corpus-only lab rules.
alert tcp $HOME_NET any -> $HOME_NET 445 (msg:"ET INFO SMB2 NT Create AndX Request For an Executable File"; flow:to_server,established; content:"|FE|SMB"; content:"|05 00|"; distance:8; within:2; content:".|00|e|00|x|00|e|00|"; nocase; distance:0; classtype:policy-violation; sid:2025701; rev:2; metadata:signature_severity Minor, confidence High, lab_standin true;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"LAB Possible beacon - repeated bare HTTP check-in"; flow:established,to_server; http.method; content:"GET"; http.header_names; content:!"Referer"; threshold:type threshold, track by_src, count 5, seconds 600; classtype:trojan-activity; sid:9190001; rev:1; metadata:signature_severity Major, confidence Medium, mitre_technique_id T1071.001;)
alert dns $HOME_NET any -> any any (msg:"LAB Possible DNS tunnelling - long query label"; dns.query; pcre:"/(?:^|\.)[a-z0-9]{40,}\./i"; threshold:type threshold, track by_src, count 3, seconds 60; classtype:bad-unknown; sid:9190002; rev:1; metadata:signature_severity Major, confidence Medium, mitre_technique_id T1071.004;)
