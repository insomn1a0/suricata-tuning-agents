# Copy to config/environment.env (git-ignored) - or let the onboarding skill fill it in.
# No secrets here: ssh uses your agent/keys, SIEM queries are run by you.

# --- Sensor (read-only account; sudo only for reading logs/rules) ---
SENSOR_SSH="analyst@sensor.lab.local"
SENSOR_SUDO="sudo -n"                 # empty if the account can read logs directly
SURICATA_LOG_DIR="/var/log/suricata"
SURICATA_ALERT_GLOB="eve.json*"       # e.g. "eve-alerts.json*" if alerts have their own EVE file
SURICATA_RULES_FILE="/var/lib/suricata/rules/suricata.rules"
SURICATA_VERSION="8.0"                # lab image tag for pcap tests - match production

# --- Wazuh ---
WAZUH_VERSION="4.14.5"                # logtest image tag - match production
WAZUH_ALERT_LEVEL="6"                 # analyst-visible threshold (log_alert_level / dashboards)
WAZUH_LOCATION="[001] (lab-sensor) any->/var/log/suricata/eve.json"   # how the sensor agent's events arrive
RULE_ID_RANGE="100200-100299"         # your team's free custom range, see wazuh/README.md

# --- Policy / preferences ---
WORK_HOURS="8-19"                     # local, Mon-Fri; used for worktime_share
CARD_LANGUAGE="en"                    # language of triage cards and journal
AUTONOMY="propose"                    # propose = agents only propose; safe-auto = may apply SAFE class (see docs/SAFETY.md)
